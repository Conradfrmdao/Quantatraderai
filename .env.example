# ═══════════════════════════════════════════════════════════════════
# QuantatraderAI — Full Environment Variables Reference
# Copy to .env for the Python backend
# Copy to ui/.env.local for the Next.js frontend
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# PYTHON BACKEND  →  .env
# ───────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/quantatrader

# ── Encryption (MUST match ui/.env.local ENCRYPTION_KEY) ───────────
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your-base64url-encoded-32-byte-key

# ── LLM Providers ─────────────────────────────────────────────────
LLM_PROVIDER=groq                       # groq | anthropic | gemini | ollama | openrouter
LLM_MODEL=llama-3.3-70b-versatile       # model name for the chosen provider
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
OLLAMA_BASE_URL=http://localhost:11434
SANITIZE_MODEL=claude-haiku-4-5-20251001

# ── AI Feature Flags ──────────────────────────────────────────────
ENABLE_COUNCIL=false        # Parallel Groq+Claude+Gemini 2/3 majority vote
ENABLE_RAG=false            # pgvector trade memory (requires OPENAI_API_KEY)
ENABLE_INTEL=false          # MTF confluence, news sentiment, correlation matrix
ENABLE_COPY_TRADING=false   # Mirror leader trades to follower accounts

# ── OpenAI (RAG embeddings only) ──────────────────────────────────
OPENAI_API_KEY=sk-...       # text-embedding-3-small; falls back to hash if unset

# ── Venue Selection ───────────────────────────────────────────────
VENUE=binance               # hyperliquid | binance | bybit | okx | kraken | oanda | metatrader | alpaca | ibkr | ccxt:<id>
ASSETS=BTC/USDT ETH/USDT
INTERVAL=1h                 # 1m | 5m | 15m | 1h | 4h | 1d

# Hyperliquid
HYPERLIQUID_PRIVATE_KEY=0x...
HYPERLIQUID_NETWORK=mainnet             # mainnet | testnet
HYPERLIQUID_VAULT_ADDRESS=             # optional

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MARKET=futures                  # futures | spot
BINANCE_SANDBOX=true

# OANDA (forex)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice                      # practice | live

# MetaTrader (via MetaAPI cloud — https://metaapi.cloud)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
MT_IS_PAPER=true

# CCXT generic
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=
CCXT_SANDBOX=true
CCXT_MARKET=spot                        # spot | futures — controls risk limits applied

# Alpaca (US stocks/options)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Interactive Brokers (requires TWS or IB Gateway running)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497              # 7497=paper, 7496=live
IBKR_CLIENT_ID=1

# ── Risk Management ───────────────────────────────────────────────
MAX_POSITION_PCT=3
MAX_LEVERAGE=2
MANDATORY_SL_PCT=2.5
MAX_LOSS_PER_POSITION_PCT=8
DAILY_LOSS_CIRCUIT_BREAKER_PCT=4
MAX_TOTAL_EXPOSURE_PCT=20
MAX_CONCURRENT_POSITIONS=5
MIN_BALANCE_RESERVE_PCT=30

# ── Alerts ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # From @BotFather on Telegram
TELEGRAM_CHAT_ID=           # Your personal chat ID

# ── Intelligence Feeds ────────────────────────────────────────────
TWELVEDATA_API_KEY=         # Economic calendar — free tier at twelvedata.com
CRYPTOCOMPARE_API_KEY=      # News sentiment — free without key, higher limits with

# ── API Server ────────────────────────────────────────────────────
API_PORT=8000
# PRODUCTION: set this to your actual frontend domain(s)
# LOCAL DEV:  leave blank (defaults to * which allows all)
ALLOWED_ORIGINS=http://localhost:3000
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Observability ─────────────────────────────────────────────────
SENTRY_DSN=                 # From https://sentry.io project settings
SENTRY_ENV=production       # production | staging | development
PROMETHEUS_PORT=9090        # Set 0 to disable Prometheus metrics server

# ── LLM Tuning ────────────────────────────────────────────────────
MAX_TOKENS=4096
THINKING_ENABLED=false
THINKING_BUDGET_TOKENS=10000
ENABLE_TOOL_CALLING=true


# ───────────────────────────────────────────────────────────────────
# NEXT.JS FRONTEND  →  ui/.env.local
# ───────────────────────────────────────────────────────────────────

# ── Clerk Auth ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
CLERK_WEBHOOK_SECRET=whsec_...          # Clerk Dashboard → Webhooks → Signing secret

# ── Database (same connection string as backend) ──────────────────
DATABASE_URL=postgresql://user:password@host:5432/quantatrader

# ── Encryption (MUST match backend ENCRYPTION_KEY) ────────────────
ENCRYPTION_KEY=your-base64url-encoded-32-byte-key

# ── API URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PYTHON_API_URL=http://localhost:8000    # Server-side proxy target (not exposed to browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WebSocket JWT auth ────────────────────────────────────────────
# Clerk Dashboard → API Keys → Show JWKS URL
# Format: https://<your-frontend-api-host>/.well-known/jwks.json
CLERK_JWKS_URL=

# ── Payment Gateway ───────────────────────────────────────────────
PAYMENT_PROVIDER=manual     # stripe | lemonsqueezy | manual
                            # Change this ONE var to swap gateways

# Stripe (PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Lemon Squeezy (PAYMENT_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ENTERPRISE=

# ── Webhooks ──────────────────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET= # Shared secret you set in TradingView Pine Script alert

# ───────────────────────────────────────────────────────────────────
# MOBILE  →  mobile/.env
# ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
EXPO_PUBLIC_API_URL=https://api.yourdomain.com
