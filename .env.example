# === Required ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here      # From https://console.anthropic.com
LLM_MODEL=claude-sonnet-4-6                        # Recommended for per-bar decisions; use claude-opus-4-7 for higher-stakes

# === Venue selection ===
VENUE=hyperliquid                                  # hyperliquid | ccxt:<exchange> | oanda
ASSETS="BTC ETH SOL"                               # Space- or comma-separated; format depends on venue
INTERVAL="5m"                                      # 1m | 5m | 15m | 1h | 4h | 1d

# === Hyperliquid (crypto perps) ===
HYPERLIQUID_PRIVATE_KEY=0x_your_agent_private_key  # API wallet private key (signer only, not main seed)
HYPERLIQUID_VAULT_ADDRESS=0x_your_main_wallet      # Main wallet address that holds funds
HYPERLIQUID_NETWORK=mainnet                        # mainnet or testnet (use testnet first!)

# === CCXT crypto exchange (e.g. Binance) ===
# Set CCXT_EXCHANGE (binance, bybit, coinbase, kraken, okx, ...) and matching keys.
# Create keys with withdrawals DISABLED and IP-allowlist them to your host.
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=
CCXT_SANDBOX=true                                  # true = testnet/sandbox where supported

# === OANDA forex ===
OANDA_API_TOKEN=                                   # Personal access token from developer.oanda.com
OANDA_ACCOUNT_ID=
OANDA_ENV=practice                                 # practice or live (start with practice!)

# === Risk management (QuntaTradeAI conservative defaults) ===
# Override per (venue, asset class) in risk.yaml; these are global fallbacks.
MAX_POSITION_PCT=3                 # Max single position as % of portfolio
MAX_LOSS_PER_POSITION_PCT=8        # Force-close at this % loss
MAX_LEVERAGE=2                     # Hard leverage cap
MAX_TOTAL_EXPOSURE_PCT=20          # Max total notional as % of portfolio
DAILY_LOSS_CIRCUIT_BREAKER_PCT=4   # Stop new trades at this daily drawdown %
MANDATORY_SL_PCT=2.5               # Auto SL distance if LLM doesn't set one
MAX_CONCURRENT_POSITIONS=5         # Max simultaneous positions
MIN_BALANCE_RESERVE_PCT=30         # Don't trade below this % of initial balance

# === Alerts (optional) ===
TELEGRAM_BOT_TOKEN=                # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                  # Your chat/user id

# === Optional Claude tuning ===
# THINKING_ENABLED=false
# THINKING_BUDGET_TOKENS=10000
# MAX_TOKENS=4096
# SANITIZE_MODEL=claude-haiku-4-5-20251001

# === API server ===
# API_HOST=0.0.0.0
# API_PORT=3000
